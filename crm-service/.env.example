# Copy this file to .env and fill in real values. Never commit the real .env.

DATABASE_URL=postgresql://aicrm_app:CHANGE_ME@localhost:5432/aicrm
JWT_SECRET=your-secret-key
DEFAULT_BUSINESS_ID=bus_001
VOICE_BOT_URL=http://localhost:8000

# Twilio (used by the in-process SMS sender crm-service calls internally)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# LLM providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
