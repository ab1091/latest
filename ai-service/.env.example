# Copy this file to .env and fill in real values. Never commit the real .env.

HOST=0.0.0.0
PORT=8000

# Auth
JWT_SECRET=your-secret-key
JWT_ACCESS_EXPIRES=3600
JWT_REFRESH_EXPIRES=2592000

# Database (shared with crm-service — same Postgres instance)
DATABASE_URL=postgresql://aicrm_app:CHANGE_ME@localhost:5432/aicrm
DEFAULT_BUSINESS_ID=bus_001

# Frontend / inter-service URLs
FRONTEND_URL=http://localhost:3000
BACKEND_API_URL=http://localhost:8000
CRM_SERVICE_URL=http://localhost:8001

# Google OAuth (Calendar integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# HubSpot integration
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_REDIRECT_URI=

# Outlook integration
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=
OUTLOOK_REDIRECT_URI=

# Twilio (voice calls + WhatsApp only — SMS sends through Sendblue instead)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Public HTTPS base URL Twilio/Vapi can reach (e.g. an ngrok tunnel in dev)
TWILIO_TWIML_BASE_URL=https://your-public-tunnel-url

# Sendblue (SMS/iMessage)
CLAW_MESSENGER_API_KEY=

# BlueBubbles (iMessage) — local server on the Mac running Messages.app,
# replacing Claw Messenger above as the active SMS/iMessage transport
BB_SERVER_URL=http://localhost:1234
BB_PASSWORD=
BB_SEND_METHOD=apple-script

# LLM providers
OPENAI_API_KEY=

# Voice
VOICE_ENGINE=vapi
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
DEEPGRAM_API_KEY=

# Vapi (outbound + inbound AI calling)
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=
REMINDER_TOOL_SECRET=
# Not read by any server-side code path today — Vapi's REST API uses
# VAPI_API_KEY (the private key). Kept for a future client-side/web-embed use.
VAPI_PUBLIC_KEY=
